[Unit]
Description=Hardware Edge Gestures Daemon for Dell Latitude 7210 (Hyprland / lisgd)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/home/johnny/.local/bin/touch-gestures run
Restart=on-failure
