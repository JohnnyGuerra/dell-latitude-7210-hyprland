#!/usr/bin/env bash
# Native Auto & Tablet Keyboard Daemon for Dell 7210 2-in-1

FOLIO_DEVICE_PATH="/sys/bus/usb/devices/1-4"
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$(ls -t "$XDG_RUNTIME_DIR"/wayland-* 2>/dev/null | head -n 1 | xargs -r basename)}"

start_wvkbd_auto() {
    if ! pgrep -f "wvkbd-deskintl.*--auto" >/dev/null 2>&1; then
        killall -9 wvkbd-deskintl 2>/dev/null
        wvkbd-deskintl \
            --auto \
            -L 300 \
            -R 10 \
            --alpha 220 \
            --bg 1a1b26 \
            --fg 24283b \
            --fg-sp 1f2335 \
            --text c0caf5 \
            --text-sp 7aa2f7 \
            --press 7aa2f7 \
            --text-press 1a1b26 \
            &
    fi
}

stop_wvkbd() {
    if pgrep -f wvkbd-deskintl >/dev/null 2>&1; then
        killall -9 wvkbd-deskintl 2>/dev/null
        ~/.local/bin/adjust-agent-size restore &
    fi
}

CURRENT_MODE=""

while true; do
    if [ -d "$FOLIO_DEVICE_PATH" ]; then
        if [ "$CURRENT_MODE" != "desktop" ]; then
            ~/.local/bin/toggle-tablet-mode desktop
            CURRENT_MODE="desktop"
        fi
    else
        if [ "$CURRENT_MODE" != "tablet" ]; then
            ~/.local/bin/toggle-tablet-mode tablet
            CURRENT_MODE="tablet"
        fi
    fi
    sleep 2
done
