#!/usr/bin/env bash
# Hardware Folio-Aware Auto-Rotation & Scratchpad Refit Daemon

FOLIO_PATH="/sys/bus/usb/devices/1-4"
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$(ls -t "$XDG_RUNTIME_DIR"/wayland-* 2>/dev/null | head -n 1 | xargs -r basename)}"
SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n 1)
[ -n "$SIG" ] && export HYPRLAND_INSTANCE_SIGNATURE="$SIG"

LAST_TF=-1

while true; do
    if [ -d "$FOLIO_PATH" ]; then
        if pgrep -x iio-hyprland >/dev/null 2>&1; then
            pkill -9 -x iio-hyprland 2>/dev/null
            ~/.local/bin/rotate-screen 0 >/dev/null 2>&1
        fi
    else
        if ! pgrep -x iio-hyprland >/dev/null 2>&1; then
            iio-hyprland >/dev/null 2>&1 &
        fi
    fi

    # Read active monitor transform directly
    CURR_TF=$(hyprctl monitors -j 2>/dev/null | jq -r .[0].transform // 0)
    if [ "$CURR_TF" != "$LAST_TF" ]; then
        LAST_TF="$CURR_TF"
        ~/.local/bin/fit-agent-window >/dev/null 2>&1
    fi

    sleep 0.25
done
