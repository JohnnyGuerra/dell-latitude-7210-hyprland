#!/usr/bin/env bash
# Tablet-Aware Screen Locker for Dell Latitude 7210 (Hyprlock + On-Screen Keyboard)

export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$(ls -t "$XDG_RUNTIME_DIR"/wayland-* 2>/dev/null | grep -v '\.lock$' | head -n 1 | xargs -r basename)}"
SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n 1)
[ -n "$SIG" ] && export HYPRLAND_INSTANCE_SIGNATURE="$SIG"

# Exit cleanly if hyprlock is already running to avoid session lock conflicts
if pidof hyprlock >/dev/null 2>&1; then
    exit 0
fi

# Clear any stale or crashed lockscreen state in Hyprland
hyprctl -i 0 eval 'hl.clear_crashed_lockscreen()' >/dev/null 2>&1 || true

# Ensure wvkbd layer rule above_lock = 2 is active in Hyprland
hyprctl -i 0 eval 'hl.layer_rule({ name = "wvkbd-lock", match = { namespace = "^(wvkbd)$" }, above_lock = 2 })' >/dev/null 2>&1 || true

# Determine if tablet mode is active:
# 1. Folio physical keyboard is detached (Alps USB 044e)
# 2. Monitor transform is rotated (portrait: 1 or 3, inverted: 2)
# 3. Explicit tablet flag file or argument
IS_TABLET=false
if ! grep -qs '044e' /sys/bus/usb/devices/*/idVendor 2>/dev/null; then
    IS_TABLET=true
fi

TF=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0].transform // 0' 2>/dev/null)
if [ -n "$TF" ] && [ "$TF" != "0" ] && [ "$TF" != "null" ]; then
    IS_TABLET=true
fi

# Parse custom arguments
HYPRLOCK_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --tablet|-t)
            IS_TABLET=true
            ;;
        *)
            HYPRLOCK_ARGS+=("$arg")
            ;;
    esac
done

if [ -f "$XDG_RUNTIME_DIR/tablet-mode" ]; then
    IS_TABLET=true
fi

# Spawn on-screen keyboard if in tablet mode
KBD_AUTO_PID=""
if [ "$IS_TABLET" = "true" ]; then
    if ! pgrep -f wvkbd-deskintl >/dev/null 2>&1; then
        wvkbd-deskintl \
            -L 300 \
            -H 380 \
            -R 12 \
            --alpha 190 \
            --bg 1e1e2e \
            --fg 313244 \
            --fg-sp 45475a \
            --text cdd6f4 \
            --text-sp cba6f7 \
            --press cba6f7 \
            --text-press 1e1e2e \
            &
        KBD_AUTO_PID=$!
    fi
fi

# Launch Hyprlock
hyprlock "${HYPRLOCK_ARGS[@]}"

# Clean up keyboard after unlock so it doesn't linger over unlocked session
if [ -n "$KBD_AUTO_PID" ] && kill -0 "$KBD_AUTO_PID" 2>/dev/null; then
    kill "$KBD_AUTO_PID" 2>/dev/null || true
fi
killall -9 wvkbd-deskintl 2>/dev/null || true
